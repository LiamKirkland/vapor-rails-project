<ul class="game-grid">
  <% games.each do |game| %>
    <li>
      <%= link_to game_path(game), class: "game-card" do %>
        <%= image_tag game.display_cover_image, width: 130, height: 182, class: "cover-thumb" %>
        <span class="game-caption"><%= game.name %> (<%= game.release_year %>)</span>
      <% end %>
    </li>
  <% end %>
</ul>