<%= form_with model: @game, scope: :game do |f| %>
  Name: <%= f.text_field :name, required: true %><br>
  Developer: <%= f.text_field :developer, required: true %><br>
  Release Date: <%= f.date_field :release_date, required: true %><br>
  Cover Image: <%= f.file_field :cover_image, accept: "image/png,image/jpeg" %><br>
  <% if @game.cover_image.attached? %>
    <%= f.check_box :remove_cover_image %>
    <%= f.label :remove_cover_image, "Remove current cover image" %><br>
  <% end %>
  <%= f.submit %>
<% end %>