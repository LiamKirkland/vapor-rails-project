<h1>Edit <%= @user.username %>'s Profile (Admin)</h1>

<%= form_with model: @user, url: admin_update_user_path(@user), method: :patch, scope: :user do |f| %>
  <%= image_tag @user.display_profile_pic, class: "pfp-img", width: 200, height: 200 %><br>
  <% if @user.profile_pic.attached? %>
    <%= f.check_box :remove_profile_pic %>
    <%= f.label :remove_profile_pic, "Remove profile picture" %><br>
  <% end %>

  Username: <%= f.text_field :username, required: true %><br>

  <%= f.check_box :admin %>
  <%= f.label :admin, "Admin privileges" %><br>

  <%= f.submit "Save Changes" %>
<% end %>