<% @user.pending_requests.each do |friendship| %>
  <div class="friend-request-row">
    <span><%= link_to friendship.user.username, user_path(friendship.user) %> has sent you a friend request.</span>
    <%= button_to "Accept", accept_friendship_path(friendship), method: :patch, class: "btn accept-btn" %>
    <%= button_to "Reject", friendship_path(friendship), method: :delete, class: "btn reject-btn" %>
  </div>
<% end %>

<h1>Welcome, <%= @user.username %>!</h1>

<h3>Your games:</h3>
<% if @user.games.empty? %>
  <i>Visit the <%= link_to 'games list', games_path%> to add some games to your collection!</i>
<% else %>
  <%= render partial: 'games/gameslist', locals: { games: @user.games } %>
<% end %>

<h3>Your friends:</h3>
<% if @user.friends_list.empty? %>
  <i>You have no friends, loser</i>
<% else %>
  <%= render partial: 'userslist', locals: { users: @user.friends_list } %>
<% end %>