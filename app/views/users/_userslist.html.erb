<ul class="user-grid">
  <% users.each do |user| %>
    <li>
      <%= link_to user_path(user), class: "user-card" do %>
        <%= image_tag user.display_profile_pic, class: "pfp-img", width: 140, height: 140 %>
        <span class="user-caption"><%= user.username %></span>
      <% end %>
    </li>
  <% end %>
</ul>