<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vapor Game Collection Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Vapor Game Collection Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <% if current_user %>
        <%= link_to 'Home', root_path %>
        <%= link_to 'Games List', games_path %>
        <%= link_to 'Add a Game', new_game_path %>
        <span>Signed in as <%= current_user.username %></span>
        <%= button_to "Log out", logout_path, method: :post %>
      <% end %>
    </nav>

    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>
    
    <%= yield %>
  </body>
</html>
