<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vapor Game Collection Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Vapor Game Collection Manager">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

  <link rel="icon" href="<%= asset_path('vapor-logo.png') %>" type="image/png">
  <link rel="apple-touch-icon" href="<%= asset_path('vapor-logo.png') %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <span class="nav-brand">
        <%= image_tag 'vapor-white.png', class: "nav-logo" %>
        VAPOR
      </span>
      <% if current_user %>
        <%= link_to 'Home', root_path %>
        <%= link_to 'Users List', users_path %>
        <%= link_to 'Games List', games_path %>
        <% if current_user&.admin? %>
          <%= link_to "Add a Game", new_game_path %>
        <% end %>
        <div class="nav-spacer"></div>
        <%= link_to edit_profile_path, class: "nav-user-pic" do %>
          <span><%= image_tag current_user.display_profile_pic, class: "pfp-img", width: 30, height: 30 %></span>
        <% end %>
        <%= button_to "Log out", logout_path, method: :post, class: "btn-secondary" %>
      <% end %>
    </nav>

    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>

    <div class="page-wrap">
      <%= yield %>
    </div>
  </body>
</html>